{
  "name": "joinproject",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate --schema=prisma/auth.prisma && prisma generate --schema=prisma/sensor.prisma",
    "start": "next start",
    "generate": "prisma generate --schema=prisma/auth.prisma && prisma generate --schema=prisma/sensor.prisma",
    "generate:auth": "prisma generate --schema=prisma/auth.prisma",
    "generate:sensor": "prisma generate --schema=prisma/sensor.prisma",
    "migrate:auth": "prisma migrate dev --schema=prisma/auth.prisma",
    "migrate:sensor": "prisma migrate dev --schema=prisma/sensor.prisma",
    "studio:auth": "prisma studio --schema=prisma/auth.prisma --port 5555",
    "studio:sensor": "prisma studio --schema=prisma/sensor.prisma --port 5556",
    "seed": "npx tsx scripts/seed.ts"
  },
  "prisma": {
    "seed": "npx tsx scripts/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.3",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.17.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "minio": "^8.0.7",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
